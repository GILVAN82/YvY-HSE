PORT=3000
DATABASE_URL=postgres://SEU_USUARIO:SUA_SENHA@localhost:5432/hse_app

# Orquestrador do agente: langgraph (padrão) | legacy
AI_ORCHESTRATOR=langgraph

# Origens permitidas pelo CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:4200

# Apenas para desenvolvimento local; a aplicação ainda não tem autenticação.
ALLOW_UNAUTHENTICATED_WRITES=false

# Provedores de IA. Nunca coloque chaves reais neste ficheiro de exemplo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.45
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api
# Temporary AI attachments (never persisted to PostgreSQL or pgvector)
AI_ATTACHMENT_TTL_MINUTES=120
AI_ATTACHMENT_MAX_FILE_MB=10
AI_ATTACHMENT_MAX_PER_THREAD=3
AI_ATTACHMENT_MAX_COMBINED_MB=25
AI_ATTACHMENT_CLEANUP_MINUTES=15
AI_ATTACHMENT_MAX_CONTEXT_CHARS=16000
