PORT=3000
DATABASE_URL=postgres://SEU_USUARIO:SUA_SENHA@localhost:5432/hse_app
YVY_ATTENTION_ENABLED=true
YVY_ATTENTION_INTERVAL_SECONDS=90
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_DISPLAY_NAME=YvY HSE Demo User
DEMO_USER_ROLE=HSE_USER
DEMO_USER_PROJECTS=PRJ-001

# Agent orchestrator: langgraph (default) | legacy
AI_ORCHESTRATOR=langgraph

# CORS allowed origins, separated by commas.
CORS_ORIGINS=http://localhost:4200

# Local development only; the application does not have authentication yet.
ALLOW_UNAUTHENTICATED_WRITES=false

# AI providers. Never place real keys in this example file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.45
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api
# Temporary AI attachments (never persisted to PostgreSQL or pgvector)
AI_ATTACHMENT_TTL_MINUTES=120
AI_ATTACHMENT_MAX_FILE_MB=10
AI_ATTACHMENT_MAX_PER_THREAD=3
AI_ATTACHMENT_MAX_COMBINED_MB=25
AI_ATTACHMENT_CLEANUP_MINUTES=15
AI_ATTACHMENT_MAX_CONTEXT_CHARS=16000
