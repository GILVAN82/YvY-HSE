{
  "name": "hse-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --test --require ts-node/register/transpile-only \"src/**/*.test.ts\"",
    "rag:ingest": "node --require ts-node/register/transpile-only src/ai/rag/ingest.cli.ts",
    "rag:retrieve:smoke": "node --require ts-node/register/transpile-only src/ai/rag/retrieve.cli.ts",
    "state:smoke": "node --require ts-node/register/transpile-only src/ai/graph/threadState.smoke.cli.ts",
    "memory:smoke": "node --require ts-node/register/transpile-only src/ai/memory/memory.smoke.cli.ts",
    "hitl:smoke": "node --require ts-node/register/transpile-only src/ai/hitl/hitl.smoke.cli.ts",
    "actions:egress:audit": "node --require ts-node/register/transpile-only src/ai/actionsEgress.audit.cli.ts",
    "eval:harness": "node --test --require ts-node/register/transpile-only src/ai/__tests__/agent-harness.test.ts",
    "eval:ai": "node --require ts-node/register/transpile-only src/ai/evaluation/evaluation.cli.ts",
    "eval:ai:live": "node --require ts-node/register/transpile-only src/ai/evaluation/evaluation.live-safe.cli.ts",
    "agent:evaluate": "node --require ts-node/register/transpile-only src/ai/evaluation/evaluation.cli.ts",
    "agent:evaluate:live-safe": "node --require ts-node/register/transpile-only src/ai/evaluation/evaluation.live-safe.cli.ts",
    "demo:reset": "node ../database/demo/reset.js",
    "demo:seed": "node ../database/demo/seed.js",
    "demo:validate": "node ../database/demo/validate.js",
    "demo:start": "node ../database/demo/start-backend.js",
    "demo:test": "node --test ../database/demo/demo.test.js ../database/demo/start-safety.test.js",
    "auth:provision": "node --require ts-node/register/transpile-only src/auth/provision.cli.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.9",
    "@ai-sdk/google": "^4.0.9",
    "@ai-sdk/openai": "^4.0.8",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.9",
    "ai": "^7.0.17",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
